<?xml version="1.0" encoding="utf-8"?>
<!--
  应用清单：声明权限、设备兼容性、应用组件。
  要点：
   1) 同一份 APK 同时提供「手机桌面图标(LAUNCHER)」与「电视/盒子入口(LEANBACK_LAUNCHER)」
   2) leanback 与 touchscreen 均声明为 required=false，保证手机、电视都能安装
   3) 允许明文 HTTP：频道源与自建后端可能是 http（如局域网地址），Android 9+ 默认禁止，需显式打开
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：加载频道列表、播放直播流、加载回放网页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：用于判断当前是否联网，给出友好提示 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 播放期间保持唤醒，避免电视盒播放中息屏 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 声明本应用可运行于电视（leanback）与手机（触摸屏），两者都不作为硬性要求 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TvLive">

        <!-- 主界面：手机与电视共用同一个 Activity，界面按设备形态自适应 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 手机/平板桌面入口 -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视/盒子启动器入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
